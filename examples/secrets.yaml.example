---
# Copy to secrets.yaml and fill in. secrets.yaml is gitignored.

wifi_ssid: my-network
wifi_password: my-password

# Kegbot Server root, e.g. https://kegbot.example.com
# A trailing slash or a trailing /api are both accepted.
kegbot_url: https://kegbot.example.com

# From your Kegbot Server account page. The board sends this as
# X-Kegbot-Api-Key; it must belong to a staff or superuser account.
kegbot_api_key: replace-me
